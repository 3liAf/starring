---
import Layout from '../components/Layout.astro';
import ProfileStory from '../story/ProfileStory';
import { store, type Profile } from '../lib/profiles';

export function getStaticPaths() {
  return store.list().map((p) => ({ params: { handle: p.handle }, props: { p } }));
}

const { p } = Astro.props as { p: Profile };
---
<Layout title={`${p.profile.name} — Showtime`} description={p.profile.tagline} theme={p.theme}>
  <ProfileStory p={p} />
  <a class="edit-fab mono" href={`/edit?from=${p.handle}`}>Edit in Showtime ✎</a>
</Layout>

<style>
  .edit-fab {
    position: fixed; right: 16px; bottom: 16px; z-index: 40;
    padding: 10px 14px; background: var(--fg); color: var(--bg); text-decoration: none;
    opacity: .0; transition: opacity .2s;
  }
  body:hover .edit-fab { opacity: .85; }
  .edit-fab:hover, .edit-fab:focus-visible { opacity: 1; }
</style>
