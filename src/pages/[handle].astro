---
import Layout from '../components/Layout.astro';
import { store, totals, heatmap, type Profile } from '../lib/profiles';

export function getStaticPaths() {
  return store.list().map((p) => ({ params: { handle: p.handle }, props: { p } }));
}

const { p } = Astro.props as { p: Profile };
const t = totals(p);
const me = p.profile;
const [first, ...rest] = me.name.split(' ');
const contributions = [...(p.contributions ?? [])].sort((a, b) => b.year - a.year);
const latest = contributions[0];
const grid = latest ? heatmap(p.handle, latest.year, latest.public + latest.private) : [];
const maxYear = Math.max(1, ...contributions.map((c) => c.public + c.private));
const clients = p.clients ?? [];
const marquee = [...clients, ...clients];
const visLabel = { public: 'Open source', private: 'Private repo', nda: 'Under NDA' } as const;
---
<Layout title={`${me.name} — Showtime`} description={me.tagline} theme={p.theme}>
  <!-- ACT 0: curtain -->
  <header class="hero">
    <div class="hero-top mono">
      <a href="/">Showtime</a>
      <span>{me.location}</span>
      {me.available && <span class="tag solid">Available for work</span>}
    </div>
    <h1 class="display hero-name">
      <span class="line">{first}</span>
      <span class="line accent">{rest.join(' ')}</span>
    </h1>
    <div class="hero-bottom">
      <p class="hero-role">{me.role}</p>
      <p class="muted hero-tag">{me.tagline}</p>
      <span class="mono scroll-cue">Scroll — the show starts ↓</span>
    </div>
  </header>

  <!-- ACT I: numbers -->
  <section class="act">
    <div class="act-label mono"><span class="num">Act I</span><span>By the numbers</span></div>
    <div class="stats">
      <div class="stat reveal"><b class="display" data-count={t.years}>0</b><span class="mono">years shipping</span></div>
      <div class="stat reveal"><b class="display" data-count={t.all}>0</b><span class="mono">commits</span></div>
      <div class="stat reveal"><b class="display" data-count={t.clients}>0</b><span class="mono">clients</span></div>
      <div class="stat reveal"><b class="display" data-count={t.repos}>0</b><span class="mono">repositories</span></div>
    </div>
    <p class="iceberg reveal">
      <span class="display accent">{t.privateShare}%</span>
      of this work lives in private repos. GitHub only shows the tip.
    </p>
    <div class="split reveal" aria-label="Public versus private commits">
      <div class="split-pub" style={`flex:${t.public}`}><span class="mono">Public {t.public.toLocaleString('en')}</span></div>
      <div class="split-priv" style={`flex:${t.private}`}><span class="mono">Private {t.private.toLocaleString('en')}</span></div>
    </div>
  </section>

  <!-- ACT II: clients -->
  {clients.length > 0 && (
    <section class="act act-clients">
      <div class="act-label mono"><span class="num">Act II</span><span>Who trusted me with production</span></div>
      <div class="marquee" aria-hidden="true">
        <div class="marquee-track display">
          {marquee.map((c) => <span class="client">{c.name}<i>✦</i></span>)}
        </div>
      </div>
      <ul class="client-list">
        {clients.map((c) => (
          <li class="reveal">
            <span class="client-name">{c.name}</span>
            <span class="muted">{c.sector}</span>
            {c.nda ? <span class="tag">NDA</span> : <span class="tag solid">Public</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- ACT III: timeline -->
  <section class="act">
    <div class="act-label mono"><span class="num">Act III</span><span>The road</span></div>
    <ol class="timeline">
      {(p.experience ?? []).map((e) => (
        <li class="tl-item reveal">
          <div class="tl-year display">{e.from}<span class="muted">–{e.to ?? 'now'}</span></div>
          <div class="tl-body">
            <h3>{e.role} <span class="muted">@ {e.company}</span></h3>
            <p>{e.summary}</p>
            {e.clients?.length ? <p class="mono muted">Clients: {e.clients.join(' · ')}</p> : null}
            <div class="chips">{e.stack?.map((s) => <span class="tag">{s}</span>)}</div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ACT IV: featured work -->
  <section class="act">
    <div class="act-label mono"><span class="num">Act IV</span><span>Featured work</span></div>
    <div class="projects">
      {(p.projects ?? []).map((pr, i) => (
        <article class={`project reveal vis-${pr.visibility}`}>
          <div class="project-meta mono">
            <span>{String(i + 1).padStart(2, '0')}</span>
            <span>{pr.year}</span>
            <span class={pr.visibility === 'public' ? 'tag solid' : 'tag'}>{visLabel[pr.visibility]}</span>
          </div>
          <h3 class="display project-title">{pr.title}</h3>
          {pr.client && <p class="mono">for <span class="accent">{pr.client}</span>{pr.role && <> · {pr.role}</>}</p>}
          <p class="project-blurb">{pr.blurb}</p>
          {pr.visibility === 'nda' && (
            <p class="redacted" title="Code and details under NDA">
              <span>source code</span> <span>internal repo url</span> <span>architecture diagram</span>
            </p>
          )}
          <ul class="impact">{pr.impact?.map((x) => <li class="display">{x}</li>)}</ul>
          <div class="chips">{pr.stack?.map((s) => <span class="tag">{s}</span>)}</div>
          {pr.url && <a class="mono project-link" href={pr.url}>View source ↗</a>}
        </article>
      ))}
    </div>
  </section>

  <!-- ACT V: activity -->
  {latest && (
    <section class="act">
      <div class="act-label mono"><span class="num">Act V</span><span>Every commit counts</span></div>
      <h2 class="display big">{latest.year}<span class="muted"> / {(latest.public + latest.private).toLocaleString('en')} contributions</span></h2>
      <div class="heat reveal" role="img" aria-label={`Contribution heatmap for ${latest.year}`}>
        {grid.map((v) => <i class={`l${v}`}></i>)}
      </div>
      <div class="years">
        {contributions.map((c) => (
          <div class="yr reveal">
            <span class="mono">{c.year}</span>
            <div class="yr-bar">
              <span class="pub" style={`width:${(c.public / maxYear) * 100}%`}></span>
              <span class="priv" style={`width:${(c.private / maxYear) * 100}%`}></span>
            </div>
            <span class="mono muted">{c.verified ? '✓ imported' : 'self-reported'}</span>
          </div>
        ))}
      </div>
      <ul class="platforms">
        {(p.platforms ?? []).map((pl) => (
          <li class="reveal">
            <span class="display">{pl.commits.toLocaleString('en')}</span>
            <span class="mono">{pl.name}</span>
            <span class="mono muted">{pl.repos} repos · {pl.kind}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- ACT VI: school & skills -->
  <section class="act">
    <div class="act-label mono"><span class="num">Act VI</span><span>Training montage</span></div>
    <div class="edu-skills">
      <ul class="edu">
        {(p.education ?? []).map((ed) => (
          <li class="reveal">
            <span class="mono muted">{ed.from}–{ed.to}</span>
            <h3>{ed.school}</h3>
            <p class="muted">{ed.degree}</p>
          </li>
        ))}
      </ul>
      <div class="skills">
        {Object.entries(p.skills ?? {}).map(([group, items]) => (
          <div class="reveal">
            <p class="mono accent">{group}</p>
            <p class="skill-items">{items.join(' / ')}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CREDITS -->
  <footer class="credits">
    <p class="mono muted">That's a wrap</p>
    <h2 class="display">Starring<br /><span class="accent">{me.name}</span></h2>
    <ul class="mono">
      {Object.entries(me.links ?? {}).map(([k, v]) => <li><a href={v}>{k} ↗</a></li>)}
    </ul>
    <p class="mono muted">Made with Showtime — open source</p>
  </footer>
</Layout>

<style>
  .hero {
    min-height: 100svh; padding: 24px var(--gutter) 40px;
    display: grid; grid-template-rows: auto 1fr auto; gap: 24px;
  }
  .hero-top { display: flex; gap: 24px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .hero-top a { text-decoration: none; color: var(--accent); }
  .hero-name { align-self: center; font-size: clamp(64px, 19vw, 320px); line-height: .95; }
  .hero-name .line { display: block; animation: rise 1.1s cubic-bezier(.2,.7,0,1) both; }
  .hero-name .line + .line { animation-delay: .12s; }
  @keyframes rise { from { transform: translateY(40%); opacity: 0; } }
  .hero-bottom { display: grid; grid-template-columns: 1fr 1fr auto; gap: 24px; align-items: end; }
  .hero-role { font-size: clamp(20px, 2.4vw, 32px); font-weight: 700; }
  .scroll-cue { animation: bob 2s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(6px); } }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .stat { background: var(--bg); padding: 32px 24px; display: flex; flex-direction: column; gap: 12px; }
  .stat b { font-size: clamp(56px, 8vw, 128px); font-weight: 400; }
  .iceberg { margin: 12vh 0 32px; font-size: clamp(22px, 3vw, 40px); max-width: 22ch; font-weight: 500; }
  .iceberg .display { font-size: 2.6em; display: block; }
  .split { display: flex; height: 72px; border: 1px solid var(--line); }
  .split > div { display: flex; align-items: center; padding: 0 12px; min-width: 0; overflow: hidden; white-space: nowrap; }
  .split-pub { background: var(--fg); color: var(--bg); }
  .split-priv { background: repeating-linear-gradient(-45deg, var(--accent) 0 10px, transparent 10px 20px); color: var(--fg); }
  .split-priv span { background: var(--bg); padding: 2px 6px; }

  .act-clients { padding-left: 0; padding-right: 0; }
  .act-clients .act-label, .client-list { padding: 0 var(--gutter); }
  .marquee { overflow: hidden; border-block: 1px solid var(--line); padding: 2vh 0; }
  .marquee-track { display: flex; width: max-content; animation: slide 40s linear infinite; font-size: clamp(56px, 10vw, 160px); }
  .client { padding-right: .4em; white-space: nowrap; }
  .client i { color: var(--accent); font-style: normal; padding-left: .4em; }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }
  .client-list { list-style: none; margin-top: 8vh; }
  .client-list li { display: grid; grid-template-columns: 2fr 1fr auto; gap: 16px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--line); font-size: clamp(18px, 2vw, 26px); }

  .timeline { list-style: none; }
  .tl-item { display: grid; grid-template-columns: minmax(180px, 30%) 1fr; gap: 32px; padding: 6vh 0; border-bottom: 1px solid var(--line); }
  .tl-year { font-size: clamp(56px, 8vw, 120px); position: sticky; top: 10vh; align-self: start; }
  .tl-year span { font-size: .4em; }
  .tl-body { display: grid; gap: 12px; max-width: 60ch; }
  .tl-body h3 { font-size: clamp(22px, 2.4vw, 32px); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }

  .projects { display: grid; gap: 4vh; }
  .project {
    border: 1px solid var(--line); padding: clamp(24px, 4vw, 56px);
    display: grid; gap: 18px; min-height: 70vh; align-content: center; position: relative;
  }
  .project.vis-nda { background: repeating-linear-gradient(135deg, transparent 0 22px, #ffffff06 22px 44px); }
  .project-meta { display: flex; gap: 20px; align-items: center; }
  .project-title { font-size: clamp(44px, 7vw, 112px); max-width: 14ch; }
  .project-blurb { font-size: clamp(18px, 1.8vw, 24px); max-width: 52ch; }
  .redacted { display: flex; flex-wrap: wrap; gap: 10px; }
  .redacted span {
    background: var(--redact); color: transparent; padding: 0 6px; user-select: none; position: relative; cursor: help;
    transition: background .3s, color .3s;
  }
  .redacted span:hover { background: var(--accent); color: var(--accent-ink); }
  .redacted span:hover::after { content: ' — classified'; }
  .impact { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 32px; }
  .impact li { font-size: clamp(26px, 3.2vw, 48px); color: var(--accent); }
  .project-link { color: var(--accent); }

  .big { font-size: clamp(56px, 9vw, 150px); margin-bottom: 4vh; }
  .big span { font-size: .3em; }
  .heat { display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 1fr); gap: 3px; overflow-x: auto; padding-bottom: 8px; }
  .heat i { width: clamp(8px, 1.4vw, 18px); aspect-ratio: 1; background: var(--line); }
  .heat .l1 { background: color-mix(in srgb, var(--accent) 25%, var(--bg)); }
  .heat .l2 { background: color-mix(in srgb, var(--accent) 50%, var(--bg)); }
  .heat .l3 { background: color-mix(in srgb, var(--accent) 75%, var(--bg)); }
  .heat .l4 { background: var(--accent); }
  .years { display: grid; gap: 10px; margin: 8vh 0; }
  .yr { display: grid; grid-template-columns: 60px 1fr 130px; gap: 16px; align-items: center; }
  .yr-bar { display: flex; height: 20px; }
  .yr-bar .pub { background: var(--fg); }
  .yr-bar .priv { background: var(--accent); }
  .platforms { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; }
  .platforms li { display: grid; gap: 4px; border-top: 4px solid var(--accent); padding-top: 16px; }
  .platforms .display { font-size: 64px; }

  .edu-skills { display: grid; grid-template-columns: 1fr 1fr; gap: 8vw; }
  .edu { list-style: none; display: grid; gap: 40px; }
  .edu h3 { font-size: clamp(24px, 2.6vw, 36px); line-height: 1.1; margin: 6px 0; }
  .skills { display: grid; gap: 32px; align-content: start; }
  .skill-items { font-size: clamp(22px, 2.4vw, 34px); font-weight: 500; line-height: 1.25; }

  .credits {
    min-height: 100svh; padding: 18vh var(--gutter); border-top: 1px solid var(--line);
    display: grid; place-content: center; text-align: center; gap: 32px;
  }
  .credits h2 { font-size: clamp(48px, 10vw, 180px); }
  .credits ul { list-style: none; display: flex; flex-wrap: wrap; gap: 24px; justify-content: center; }
  .credits a { color: var(--accent); }

  @media (max-width: 760px) {
    .hero-bottom { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr 1fr; }
    .tl-item { grid-template-columns: 1fr; gap: 12px; }
    .tl-year { position: static; }
    .client-list li { grid-template-columns: 1fr auto; }
    .client-list li .muted { display: none; }
    .yr { grid-template-columns: 48px 1fr; }
    .yr > :last-child { display: none; }
    .edu-skills { grid-template-columns: 1fr; }
  }
</style>
